<Window x:Class="StreamKartoteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StreamKartoteka.Controls"
        xmlns:converters="clr-namespace:StreamKartoteka.Converters"
        mc:Ignorable="d"
        Title="ZombieLilčin konsolidátor odpovědí"
        Icon="Assets/ZombieLilcin.ico"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0A12"
        Foreground="#F7F4FF"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:PendingCountTextConverter x:Key="PendingCountText" />
        <converters:HandledOpacityConverter x:Key="HandledOpacity" />

        <SolidColorBrush x:Key="PanelBrush" Color="#15131F" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1C1928" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#2C283B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9D97AE" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#9B7BFF" />
        <SolidColorBrush x:Key="PurpleDarkBrush" Color="#6D4BEA" />
        <SolidColorBrush x:Key="GreenBrush" Color="#4ADE80" />

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F7F4FF" />
            <Setter Property="Background" Value="#0F0E17" />
            <Setter Property="BorderBrush" Value="#383247" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#BCA9FF" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#F7F4FF" />
            <Setter Property="Background" Value="#0F0E17" />
            <Setter Property="BorderBrush" Value="#383247" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#BCA9FF" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PurpleDarkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8062F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5837CC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#272334" />
            <Setter Property="Foreground" Value="#E7E1F5" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3C364C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#332E43" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#211D2D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="46" Height="46" CornerRadius="13" Background="#291F4A" Margin="0,0,14,0">
                <Image Source="Assets/ZombieLilcin-icon-source.png" Stretch="Uniform" Margin="3" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ZombieLilčin konsolidátor odpovědí"
                           FontSize="19"
                           FontWeight="Bold" />
                <TextBlock Text="Každý divák na svém místě. Každá zpráva ve správném pořadí."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="2"
                    CornerRadius="16"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    Background="#12101A"
                    Padding="13,7"
                    MaxWidth="480"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#6B6478" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="#D8D2E5"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="13"
                Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="KANÁL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,5" />
                    <TextBox x:Name="ChannelTextBox" ToolTip="Název kanálu bez twitch.tv/" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="TWITCH ÚČET" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,5" />
                    <TextBox x:Name="LoginTextBox" ToolTip="Účet, pro který byl vytvořen token" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="OAUTH TOKEN · JEN CHAT:READ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,5" />
                    <PasswordBox x:Name="TokenPasswordBox" ToolTip="Token zůstává pouze v paměti této aplikace" />
                </StackPanel>

                <Button x:Name="ConnectButton"
                        Grid.Column="6"
                        Content="{Binding ConnectionButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Click="ConnectButton_Click" />

                <Button Grid.Column="8"
                        Content="Demo"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom"
                        Click="DemoButton_Click"
                        ToolTip="Naplní aplikaci ukázkovými zprávami bez připojení" />

                <Button Grid.Column="10"
                        Content="?"
                        Width="40"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Bottom"
                        Click="HelpButton_Click"
                        ToolTip="Jak získat bezpečný Twitch token" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="DIVÁCI" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBlock Margin="0,5,0,0" Foreground="#DCD5E9" FontSize="13">
                                <Run Text="{Binding UserCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" uživatelů  ·  " />
                                <Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" čeká" />
                            </TextBlock>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Vyčistit"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                FontSize="11"
                                Click="ClearButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Border Width="54" Height="54" CornerRadius="27" BorderBrush="#3A3448" BorderThickness="1" Background="#1B1825">
                                <TextBlock Text="…" FontSize="25" Foreground="#746D82" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0" />
                            </Border>
                            <TextBlock Text="Kartotéka je prázdná"
                                       Margin="0,13,0,4"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Připojte chat nebo spusťte demo."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Users}"
                                  Visibility="{Binding HasUsers, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:FilingPanel CardHeight="104" NormalGap="10" MinimumStep="35" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="104"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        Padding="13,11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#201C2C" />
                                            <Setter Property="BorderBrush" Value="#3A334A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="#2B2350" />
                                                    <Setter Property="BorderBrush" Value="#8E70F4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter Property="Opacity" Value="0.58" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" Background="{Binding Accent}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PendingCount, Converter={StaticResource PendingCountText}}" Foreground="#B9ADDB" FontSize="11" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding LatestText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding LatestTime}" Foreground="#817A90" FontSize="10" HorizontalAlignment="Right" />
                                            <Border Margin="0,9,0,0" Padding="6,2" CornerRadius="7" Background="#16131F">
                                                <TextBlock FontSize="9" Foreground="#A69FB3">
                                                    <Run Text="#" />
                                                    <Run Text="{Binding DisplayIndex, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                <Grid>
                    <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <Border Width="78" Height="78" CornerRadius="23" Background="#1D1929" BorderBrush="#332D43" BorderThickness="1">
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="#7664B5" Margin="-27,0,0,0" />
                                    <Ellipse Width="8" Height="8" Fill="#967DEA" />
                                    <Ellipse Width="8" Height="8" Fill="#BBAAFF" Margin="27,0,0,0" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Čekám na první zprávu"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,8" />
                            <TextBlock Text="Jakmile někdo napíše do Twitch chatu, jeho karta se objeví vlevo a zpráva bude připravena tady."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       LineHeight="21" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="PRÁVĚ NA ŘADĚ" Foreground="#A997E7" FontWeight="Bold" FontSize="11" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                    <Run Text="Ve frontě zbývá " />
                                    <Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="Bold" Foreground="#EDE7F8" />
                                    <Run Text=" zpráv" />
                                </TextBlock>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Background="#1E1A29" BorderBrush="#342E43" BorderThickness="1" Padding="10,6">
                                <TextBlock Text="FIFO · podle času přijetí" Foreground="#958DA4" FontSize="11" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#211B35"
                                BorderBrush="#6F55C9"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="29" Background="{Binding CurrentUser.Accent}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentUser.Initial}" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentMessage.Text}"
                                               TextWrapping="Wrap"
                                               FontSize="20"
                                               LineHeight="29"
                                               Foreground="#FCFAFF"
                                               Margin="0,13,12,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding CurrentMessage.SentAt, StringFormat={}{0:HH:mm:ss}}"
                                           Foreground="#978DA9"
                                           FontSize="11"
                                           Margin="12,3,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="KONVERZACE TOHOTO DIVÁKA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CurrentUser.Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2F2A3D"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,10"
                                                    Opacity="{Binding IsHandled, Converter={StaticResource HandledOpacity}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="7" Height="7" Fill="{Binding DataContext.CurrentUser.Accent, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="#DCD6E8" TextWrapping="Wrap" FontSize="13" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SentAt, StringFormat={}{0:HH:mm}}" Foreground="#746D80" FontSize="10" Margin="12,2,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Row="6">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11">
                                <Run Text="Odpovězte divákovi ve streamu, potom pokračujte." />
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    Content="Další zpráva  →"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="24,12"
                                    FontSize="15"
                                    Click="NextButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
